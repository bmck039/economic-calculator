# Example configuration. Copy this to `config.env` (`python run.py` does that for you on first run).
# One KEY=VALUE per line.

# Free key from https://api.census.gov/data/key_signup.html (US rents from the ACS).
CENSUS_API_KEY=

# ---- Web server ----------------------------------------------------------
# HOST=localhost  -> only this computer can open the app.
# HOST=0.0.0.0    -> listen on every network interface (for self-hosting / LAN).
HOST=localhost
PORT=8501
# Serve under a sub-path behind a reverse proxy, e.g. BASE_URL_PATH=econ
# -> https://example.com/econ/. Leave empty to serve at the root.
BASE_URL_PATH=
# Open a browser tab on start (set false on a headless server).
OPEN_BROWSER=true

# ---- Setup -----------------------------------------------------------------
# Where the venv is created (ignored when a venv/conda env is already active).
VENV_DIR=.venv
# When run.py runs the tests: first-run (after an install or data build), always, never.
RUN_TESTS=first-run

# ---- Docker / Cloudflare Tunnel (website mode, see compose.yaml) ----------
# Token from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> Docker install command.
TUNNEL_TOKEN=
